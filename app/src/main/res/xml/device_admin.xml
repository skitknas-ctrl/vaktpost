<?xml version="1.0" encoding="utf-8"?>
<!-- Vaktpost behöver bara se misslyckade upplåsningsförsök (watch-login). Inga andra administratörsrättigheter begärs:
     appen kan alltså inte låsa, radera eller styra telefonen, bara få en signal när fel kod skrivs in. -->
